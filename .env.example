# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real keys.

# Session cookie signing key — set a long random string in any shared/production environment
SESSION_SECRET=dev-only-change-in-production

# AI Query Copilot — calls the Claude API directly.
# Leave ANTHROPIC_API_KEY empty to run in offline fallback mode (static analyzer only).
# Get a key at https://console.anthropic.com
#   ANTHROPIC_API_KEY=sk-ant-...
#   ANTHROPIC_MODEL=claude-sonnet-5   (optional — this is the default)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Documentation tab image storage — a Vercel Blob store's read/write token.
# On Vercel: Storage → Blob → connect the store to this project and it's
# injected automatically. Self-hosted/local: create a store at
# vercel.com/dashboard/stores and paste its token here.
# Leave empty to disable image uploads (documentation text still works).
BLOB_READ_WRITE_TOKEN=

# "Sign in with MD Portal" (OIDC-lite SSO) — required; this app has no local
# password login, so these vars must be set for anyone to sign in. Register
# this app in MD Portal's client registry (Admin only) to get
# MD_PORTAL_CLIENT_ID/SECRET.
# MD_PORTAL_ISSUER=http://localhost:4000
# MD_PORTAL_CLIENT_ID=
# MD_PORTAL_CLIENT_SECRET=
# This app's own public base URL, used to build its redirect_uri.
# MDQUERY_BASE_URL=http://localhost:3000
# Only set this if MD Portal's token/JWKS endpoints aren't reachable at
# MD_PORTAL_ISSUER itself (e.g. separate Docker containers in local dev).
# Token claims are still verified against MD_PORTAL_ISSUER either way.
# MD_PORTAL_INTERNAL_URL=
MD_PORTAL_ISSUER=
MD_PORTAL_CLIENT_ID=
MD_PORTAL_CLIENT_SECRET=
MDQUERY_BASE_URL=
MD_PORTAL_INTERNAL_URL=
