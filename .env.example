# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real keys.

# Session cookie signing key — set a long random string in any shared/production environment
SESSION_SECRET=dev-only-change-in-production

# AI Query Copilot — any OpenAI-compatible endpoint serving an open-weight model.
# Leave AI_BASE_URL empty to run in offline fallback mode (static analyzer only).
#
# Groq (recommended starting point — free tier at https://console.groq.com):
#   AI_BASE_URL=https://api.groq.com/openai/v1
#   AI_API_KEY=gsk_...
#   AI_MODEL=llama-3.3-70b-versatile
#
# Local Ollama on the Windows host (query text never leaves the machine):
#   AI_BASE_URL=http://host.docker.internal:11434/v1
#   AI_API_KEY=
#   AI_MODEL=qwen2.5-coder:7b
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
